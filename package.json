{
  "name": "opencode-pita-plugin",
  "type": "module",
  "version": "0.0.0",
  "description": "OpenCode plugin 'pita'",
  "dependencies": {
    "@opencode/plugin": "2.0.23"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "bundle:local": "npm run bundle -- --target=./.opencode/plugins/pita",
    "bundle:global": "npm run bundle -- --target=$HOME/.config/opencode/plugins/pita",
    "watch:local": "node --watch --watch-path=src scripts/bundle.mjs --target=./.opencode/plugins/pita",
    "watch:global": "node --watch --watch-path=src scripts/bundle.mjs --target=$HOME/.config/opencode/plugins/pita",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest ui"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.23",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "^4.0.0",
    "vitest": "^5.0.3"
  }
}
