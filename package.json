{
  "name": "opencode-pita-plugin",
  "type": "module",
  "version": "0.0.0",
  "description": "OpenCode plugin 'pita'",
  "dependencies": {
    "@opencode/plugin": "2.0.23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && babel src --out-dir dist --extensions .ts,.tsx --delete-dir-on-start",
    "bundle:local": "npm run build && node scripts/opencode-bundle.mjs local && npm install --prefix .opencode/plugins/pita --omit=dev --no-package-lock --ignore-scripts",
    "bundle:global": "npm run build && node scripts/opencode-bundle.mjs global && npm install --prefix $HOME/.config/opencode/plugins/pita --omit=dev --no-package-lock --ignore-scripts",
    "watch:local": "npm run bundle:local && babel src --out-dir .opencode/plugins/pita --extensions .ts,.tsx --watch",
    "watch:global": "npm run bundle:global && babel src --out-dir $HOME/.config/opencode/plugins/pita --extensions .ts,.tsx --watch",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest ui",
    "bundle:standalone": "npm run build && node --experimental-ffi --conditions=browser dist/hosts/standalone/standalone.js",
    "watch:standalone": "sh scripts/watch-standalone.sh",
    "test:unit": "vitest run tests/unit",
    "test:acceptance": "npm run build && node --experimental-ffi --conditions=browser --test tests/acceptance/*.test.ts",
    "test:apfel:live": "npm run build && node --experimental-ffi --conditions=browser --test tests/live/apfel.test.ts",
    "verify": "npm run lint && npm run build && npm run test:unit && npm run test:acceptance"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.0",
    "@opencode/theme": "2.0.23",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "babel-preset-solid": "^1.9.12",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.4.0",
      "onFail": "error"
    }
  }
}
